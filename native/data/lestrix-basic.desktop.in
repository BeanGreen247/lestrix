[Desktop Entry]
Type=Application
Name=Lestrix Basic
GenericName=Terminal Emulator
Comment=A bare terminal window: no menu bar, tabs, sidebar or stats
Exec=@BINDIR@/lestrix --basic
Icon=lestrix
Terminal=false
StartupNotify=true
Categories=System;TerminalEmulator;
Keywords=terminal;shell;console;basic;
StartupWMClass=lestrix-basic
